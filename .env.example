# Boros Maker Reward Bot - env example
# Copy to .env and fill real values. Do not commit .env.

# === Root wallet ===
BOROS_ROOT_ADDRESS=0x...
BOROS_ROOT_KEY=0x...

# === Agent wallet ===
AGENT_PRIVATE_KEY=0x...

# === Boros API ===
BOROS_OPEN_API=https://api-boros.pendle.finance/apis
BOROS_SEND_TX_API=https://api.boros.finance/send-txs-bot/v2
BOROS_API_KEY=

# === Network ===
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
CHAIN_ID=42161

# === Maker reward execution ===
# Public examples stay dry-run. Enable live trading only after preflight passes.
BOROS_REAL_PYTHON_PATH=
BOROS_LIVE_TRADING=0
BOROS_USE_MCP=1
BOROS_SIMULATE_BEFORE_EXECUTE=1
BOROS_MAKER_TIF=4

# === Capital snapshot used when live account data is not available ===
BOROS_CAPITAL_TOKEN_1_USD=40
BOROS_CAPITAL_TOKEN_2_USD=51
BOROS_CAPITAL_TOKEN_3_USD=14

# === Market selection ===
BOROS_MAX_MARKETS=3
BOROS_MAX_MARKETS_PER_TOKEN=1
BOROS_MIN_ROI_ANNUAL_PCT=50
BOROS_CAPITAL_UTILIZATION_PCT=0.75
BOROS_MAX_ALLOC_PER_MARKET_PCT=0.90

# === Order sizing and anti-fill quoting ===
BOROS_MIN_ORDER_NOTIONAL_USD=10
BOROS_EST_IM_RATE=0.06
BOROS_N_LEVELS=6
BOROS_OUTER_EDGE_FRACTION=0.95
BOROS_INNER_EDGE_FRACTION=0.70
BOROS_SAFETY_MARGIN_BPS=5
BOROS_REQUOTE_MID_SHIFT_BPS=3
BOROS_SNAPSHOT_FREEZE_BEFORE_SEC=180
BOROS_SNAPSHOT_FREEZE_AFTER_SEC=120

# === Risk and cost controls ===
BOROS_MAX_POSITION_USD=50
BOROS_STOP_LOSS_PCT=0.02
BOROS_MIN_HEALTH_RATIO=1.5
BOROS_MIN_GAS_BALANCE_USD=1
BOROS_ALLOW_EMERGENCY_TAKER=1
BOROS_REQUIRE_ALERT_FOR_LIVE=1
BOROS_REQUIRE_SMTP_FOR_LIVE=0
BOROS_PREFLIGHT_MIN_ORDER_COUNT=1
BOROS_DAILY_GAS_BUDGET_USD=2
BOROS_MAX_CU_PER_MINUTE=200
BOROS_MAX_CU_PER_WEEK=400000
BOROS_WEEKLY_SOFT_CAP_PCT=0.85
PENDLE_DEFAULT_USD=1.85

# === Alerts ===
# Telegram is the primary live alert channel.
ALERT_CHANNEL=telegram
ALERT_TELEGRAM_BOT_USERNAME=YiyioneBot
ALERT_TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
ALERT_TELEGRAM_CHAT_ID=@Jiucai_professor_or_numeric_chat_id
ALERT_TELEGRAM_TIMEOUT_SEC=30

# Optional email fallback. Set ALERT_CHANNEL=both to use it.
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=xianhan4@gmail.com
ALERT_SMTP_PASS=your_gmail_app_password
ALERT_EMAIL=xianhan4@gmail.com
ALERT_LOSS_THRESHOLD_USD=25
